# Copy to .env and fill in. Every value is optional - ClauseGuard runs without
# any of them, using the deterministic policy engine in place of the LLM agent.

# ---- Agentic decision layer (Claude Haiku 4.5) ----
# Get a key at https://console.anthropic.com
CLAUSEGUARD_ANTHROPIC_API_KEY=
CLAUSEGUARD_AGENT_MODEL=claude-haiku-4-5-20251001
CLAUSEGUARD_AGENT_ENABLED=true

# ---- Runtime ----
CLAUSEGUARD_ENV=dev
CLAUSEGUARD_DEVICE=auto          # auto | cpu | mps | cuda
CLAUSEGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- Verification thresholds ----
# Defaults come from scripts/calibrate.py against the ContractNLI dev split.
# Override only if you have re-calibrated.
CLAUSEGUARD_VERIFIER_ENABLED=true
CLAUSEGUARD_ENTAILMENT_THRESHOLD=0.62
CLAUSEGUARD_CONTRADICTION_THRESHOLD=0.50
CLAUSEGUARD_UNCERTAIN_BAND=0.12
